{
  "name": "f1-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/prerender.jsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test",
    "e2e": "playwright test",
    "fetch-data": "node scripts/fetch-f1-data.mjs",
    "fetch-openf1": "node scripts/fetch-openf1-data.mjs",
    "fetch-all": "node scripts/fetch-f1-data.mjs && node scripts/fetch-openf1-data.mjs",
    "fetch-quotes": "python scripts/fetch-driver-quotes.py",
    "fetch-tracks": "node scripts/fetch-tracks.mjs",
    "build-stats": "node scripts/build-season-stats.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "vite": "^8.3.5"
  }
}
